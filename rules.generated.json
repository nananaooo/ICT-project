{
  "checks": [
    {
      "name": "domain-class",
      "rules": [
        {
          "id": "R_domain_class",
          "type": "domain",
          "column": "class",
          "allowed_values": [
            "buggy",
            "clean"
          ],
          "min_compliance": 1,
          "severity": "high"
        }
      ]
    },
    {
      "name": "selector-missing",
      "rules": [
        {
          "id": "R_missing_numeric_all",
          "type": "missing_rate",
          "selector": {
            "dtype": [
              "numeric"
            ],
            "exclude": [
              "class"
            ]
          },
          "max": 0.01,
          "severity": "medium"
        }
      ]
    },
    {
      "name": "selector-type",
      "rules": [
        {
          "id": "R_type_numeric_all",
          "type": "type",
          "selector": {
            "dtype": [
              "numeric"
            ],
            "exclude": [
              "class"
            ]
          },
          "expected": "numeric",
          "min_parse_success": 0.99,
          "severity": "medium"
        }
      ]
    },
    {
      "name": "selector-outlier",
      "rules": [
        {
          "id": "R_outlier_iqr_numeric_all",
          "type": "outlier",
          "selector": {
            "dtype": [
              "numeric"
            ],
            "exclude": [
              "class"
            ]
          },
          "method": "iqr",
          "max_rate": 0.15,
          "severity": "medium"
        }
      ]
    }
  ]
}